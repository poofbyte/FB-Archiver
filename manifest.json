{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html",
      "default_title": "Downloader for Facebook"
   },
   "background": {
      "service_worker": "background-enhanced.js",
      "type": "module"
   },
   "content_scripts": [ {
      "css": [ "styles/overlay-buttons.css" ],
      "js": [ "serp-bundles/content-1.graph.js" ],
      "matches": [ "https://facebook.com/*", "https://www.facebook.com/*", "https://m.facebook.com/*", "https://*.facebook.com/*" ],
      "run_at": "document_idle"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self';"
   },
   "description": "One-click downloads from Facebook — videos, images, and post text from visible posts.",
   "host_permissions": [ "https://api.github.com/*", "https://facebook.com/*", "https://www.facebook.com/*", "https://m.facebook.com/*", "https://*.facebook.com/*", "https://*.fbcdn.net/*", "https://*.fbsbx.com/*", "https://*.cdninstagram.com/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Downloader for Facebook",
   "permissions": [ "downloads", "activeTab", "storage", "tabs", "scripting", "cookies", "declarativeNetRequest" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "4.0.1",
   "web_accessible_resources": [ {
      "matches": [ "*://*/*" ],
      "resources": [ "offscreen-faststream.html", "offscreen-faststream-legacy.js" ]
   } ]
}
